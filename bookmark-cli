#!/usr/bin/env bash
# ── Bookmark CLI ──────────────────────────────────────────────────────────────
# Thin wrapper around docker compose.
# Install: sudo cp bookmark-cli /usr/local/bin/bookmark && sudo chmod +x /usr/local/bin/bookmark

set -euo pipefail

# Find the repo root — works whether you call this from anywhere
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[bookmark]${RESET} $*"; }
success() { echo -e "${GREEN}[✓]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[!]${RESET} $*"; }
err()     { echo -e "${RED}[✗]${RESET} $*" >&2; exit 1; }

# Ensure docker and docker compose are available
require_docker() {
  if ! command -v docker &>/dev/null; then
    err "Docker not found. Install it from https://docs.docker.com/get-docker/"
  fi
  if ! docker compose version &>/dev/null 2>&1; then
    err "Docker Compose not found. It comes with Docker Desktop — update Docker."
  fi
}

cd "$REPO_ROOT"

cmd_start() {
  require_docker
  info "Starting Bookmark..."
  docker compose up -d
  echo ""
  success "Bookmark is running."
  echo -e "  ${BOLD}React app:${RESET}   http://localhost:8081"
  echo -e "  ${BOLD}Django API:${RESET}  http://localhost:8080"
  echo ""
  warn "First run: Ollama is pulling models in the background."
  warn "This takes a few minutes. Run 'bookmark logs ollama' to watch progress."
}

cmd_stop() {
  require_docker
  info "Stopping Bookmark..."
  docker compose down
  success "Bookmark stopped. Your data is safe."
}

cmd_restart() {
  require_docker
  info "Restarting Bookmark..."
  docker compose restart
  success "Bookmark restarted."
}

cmd_status() {
  require_docker
  echo ""
  echo -e "  ${BOLD}Bookmark — Service Status${RESET}"
  echo "  ──────────────────────────────────────────"
  docker compose ps
  echo ""
}

cmd_logs() {
  require_docker
  local service="${2:-}"     # optional: bookmark logs backend
  local lines="${3:-50}"     # optional: bookmark logs backend 100

  if [[ -n "$service" ]]; then
    docker compose logs "$service" --tail="$lines" --follow
  else
    docker compose logs --tail="$lines" --follow
  fi
}

cmd_update() {
  require_docker
  info "Pulling latest code..."
  git pull

  info "Rebuilding containers..."
  docker compose up -d --build

  info "Running migrations..."
  docker compose exec backend python manage.py migrate

  success "Bookmark updated and restarted."
}

cmd_uninstall() {
  require_docker
  echo ""
  echo -e "  ${RED}${BOLD}Full Uninstall${RESET}"
  echo -e "  This will remove:"
  echo -e "    • All running containers"
  echo -e "    • PostgreSQL data volume ${RED}(your saved bookmarks will be deleted)${RESET}"
  echo -e "    • Ollama models volume ${YELLOW}(models will need to re-download)${RESET}"
  echo -e "    • Generated .env file"
  echo -e "    • logs/ and tmp/ folders"
  echo ""
  echo -e "  ${YELLOW}Your source code and git history are NOT touched.${RESET}"
  echo ""
  read -rp "  Type 'yes' to confirm: " confirm
  [[ "$confirm" == "yes" ]] || { info "Aborted."; exit 0; }

  docker compose down -v --remove-orphans
  rm -f "$REPO_ROOT/.env"
  rm -rf "$REPO_ROOT/logs"
  rm -rf "$REPO_ROOT/tmp"

  echo ""
  success "Uninstall complete. To reinstall: bash install.sh"
}

cmd_shell() {
  require_docker
  # Open a shell inside the backend container for debugging
  docker compose exec backend bash
}

cmd_help() {
  echo ""
  echo -e "  ${BOLD}bookmark${RESET} — Local AI Bookmark Intelligence"
  echo ""
  echo -e "  ${BOLD}Usage:${RESET}  bookmark <command>"
  echo ""
  echo -e "  ${BOLD}Commands:${RESET}"
  echo -e "    ${CYAN}start${RESET}                 Start all services"
  echo -e "    ${CYAN}stop${RESET}                  Stop all services"
  echo -e "    ${CYAN}restart${RESET}               Restart all services"
  echo -e "    ${CYAN}status${RESET}                Show running containers"
  echo -e "    ${CYAN}logs${RESET}                  Tail logs for all services"
  echo -e "    ${CYAN}logs <service>${RESET}         Tail logs for one service"
  echo -e "                          Services: backend, frontend, db, ollama"
  echo -e "    ${CYAN}logs <service> <n>${RESET}    Tail last n lines"
  echo -e "    ${CYAN}update${RESET}                Pull latest code and rebuild"
  echo -e "    ${CYAN}shell${RESET}                 Open bash inside backend container"
  echo -e "    ${CYAN}uninstall${RESET}             Remove everything (data included)"
  echo ""
  echo -e "  ${BOLD}App:${RESET}"
  echo -e "    React  →  http://localhost:8081"
  echo -e "    Django →  http://localhost:8080"
  echo ""
}

case "${1:-help}" in
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      cmd_logs "$@" ;;
  update)    cmd_update ;;
  shell)     cmd_shell ;;
  uninstall) cmd_uninstall ;;
  help|*)    cmd_help ;;
esac